# Qloo hackathon API (required)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# OpenAI (required for writer + refine agent; template fallback works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Upstash Redis (required for cache, brief store, rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
