# Qloo hackathon API (required)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# OpenAI (required for destination + venue “why” copy; template/evidence UI without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional — set for Azure OpenAI / compatible gateways
# OPENAI_BASE_URL=https://YOUR_RESOURCE.openai.azure.com/openai/deployments/YOUR_DEPLOYMENT

# Upstash Redis (required for cache, brief/move store, rate limits in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk auth (optional — without these keys, app runs as demo-user)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
